{
 "id": "aws-cur2",
 "version": 1,
 "trust": "builtin",
 "detect": {
  "required": [
   "line_item_unblended_cost",
   "line_item_product_code"
  ],
  "any_of": [
   [
    "line_item_usage_start_date"
   ]
  ]
 },
 "meta": {
  "provider": "aws",
  "kind": "cost_lines",
  "cost_basis": "billed",
  "format": "AWS CUR 2.0 (also legacy CUR queried via Athena)",
  "exact_columns": true
 },
 "columns": {
  "product_code": {
   "from": [
    "line_item_product_code",
    "product_servicecode"
   ]
  },
  "service_raw": {
   "from": [
    "product_product_name",
    "line_item_product_code"
   ],
   "coalesce": true
  },
  "description": {
   "from": [
    "line_item_line_item_description",
    "line_item_usage_type"
   ],
   "coalesce": true
  },
  "billed_cost": {
   "from": [
    "line_item_unblended_cost"
   ]
  },
  "list_cost": {
   "from": [
    "pricing_public_on_demand_cost"
   ]
  },
  "quantity": {
   "from": [
    "line_item_usage_amount"
   ]
  },
  "unit": {
   "from": [
    "pricing_unit"
   ]
  },
  "unit_price": {
   "from": [
    "line_item_unblended_rate"
   ]
  },
  "charge_start": {
   "from": [
    "line_item_usage_start_date"
   ]
  },
  "charge_end": {
   "from": [
    "line_item_usage_end_date"
   ]
  },
  "region": {
   "from": [
    "product_region_code",
    "product_region",
    "product_location"
   ],
   "coalesce": true
  },
  "account_id": {
   "from": [
    "line_item_usage_account_id"
   ]
  },
  "account_name": {
   "from": [
    "line_item_usage_account_name"
   ]
  },
  "currency": {
   "from": [
    "line_item_currency_code"
   ]
  },
  "charge_type": {
   "from": [
    "line_item_line_item_type"
   ]
  },
  "invoice_id": {
   "from": [
    "bill_invoice_id"
   ]
  },
  "usage_type": {
   "from": [
    "line_item_usage_type"
   ]
  },
  "line_type_raw": {
   "from": [
    "line_item_line_item_type"
   ],
   "t": [
    "strip"
   ]
  },
  "coverage": {
   "from": [
    "line_item_line_item_type"
   ],
   "t": [
    "strip",
    "coverage"
   ]
  },
  "instance_type": {
   "from": [
    "product_instance_type"
   ]
  },
  "operating_system": {
   "from": [
    "product_operating_system"
   ]
  },
  "database_engine": {
   "from": [
    "product_database_engine"
   ]
  },
  "deployment_option": {
   "from": [
    "product_deployment_option"
   ]
  },
  "commitment_id": {
   "from": [
    "reservation_reservation_a_r_n",
    "savings_plan_savings_plan_a_r_n"
   ],
   "coalesce": true
  },
  "sku_id": {
   "from": [
    "product_sku"
   ]
  },
  "sku_price_id": {
   "from": [
    "pricing_rate_code"
   ]
  },
  "operation": {
   "from": [
    "line_item_operation"
   ]
  },
  "tenancy": {
   "from": [
    "product_tenancy"
   ]
  },
  "license_model": {
   "from": [
    "product_license_model"
   ]
  },
  "pre_installed_sw": {
   "from": [
    "product_pre_installed_sw"
   ]
  },
  "list_unit_price": {
   "from": [
    "pricing_public_on_demand_rate"
   ]
  },
  "pricing_term": {
   "from": [
    "pricing_term"
   ]
  },
  "purchase_option": {
   "from": [
    "pricing_purchase_option",
    "savings_plan_payment_option"
   ],
   "coalesce": true
  },
  "resource_id": {
   "from": [
    "line_item_resource_id"
   ]
  },
  "commitment_term": {
   "from": [
    "pricing_lease_contract_length",
    "savings_plan_purchase_term"
   ],
   "coalesce": true
  }
 },
 "derive": {
  "effective_cost": "cur_effective(line_type_raw, billed_cost, col(\"reservation_effective_cost\"), col(\"savings_plan_savings_plan_effective_cost\"), col(\"reservation_unused_amortized_upfront_fee_for_billing_period\"), col(\"reservation_unused_recurring_fee\"), col(\"savings_plan_total_commitment_to_date\"), col(\"savings_plan_used_commitment\"))"
 },
 "maps": {
  "product": "product_"
 }
}
