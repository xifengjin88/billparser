{
 "id": "aws-cur-legacy",
 "version": 1,
 "trust": "builtin",
 "detect": {
  "required": [
   "lineItem/UnblendedCost",
   "lineItem/ProductCode"
  ]
 },
 "meta": {
  "provider": "aws",
  "kind": "cost_lines",
  "cost_basis": "billed",
  "format": "AWS legacy CUR (CSV column style)",
  "exact_columns": true
 },
 "columns": {
  "product_code": {
   "from": [
    "lineItem/ProductCode",
    "product/servicecode"
   ]
  },
  "service_raw": {
   "from": [
    "product/ProductName",
    "lineItem/ProductCode"
   ],
   "coalesce": true
  },
  "description": {
   "from": [
    "lineItem/LineItemDescription",
    "lineItem/UsageType"
   ],
   "coalesce": true
  },
  "billed_cost": {
   "from": [
    "lineItem/UnblendedCost"
   ]
  },
  "list_cost": {
   "from": [
    "pricing/publicOnDemandCost"
   ]
  },
  "quantity": {
   "from": [
    "lineItem/UsageAmount"
   ]
  },
  "unit": {
   "from": [
    "pricing/unit"
   ]
  },
  "unit_price": {
   "from": [
    "lineItem/UnblendedRate"
   ]
  },
  "charge_start": {
   "from": [
    "lineItem/UsageStartDate"
   ]
  },
  "charge_end": {
   "from": [
    "lineItem/UsageEndDate"
   ]
  },
  "region": {
   "from": [
    "product/regionCode",
    "product/region",
    "product/location"
   ],
   "coalesce": true
  },
  "account_id": {
   "from": [
    "lineItem/UsageAccountId"
   ]
  },
  "currency": {
   "from": [
    "lineItem/CurrencyCode"
   ]
  },
  "charge_type": {
   "from": [
    "lineItem/LineItemType"
   ]
  },
  "invoice_id": {
   "from": [
    "bill/InvoiceId"
   ]
  },
  "usage_type": {
   "from": [
    "lineItem/UsageType"
   ]
  },
  "line_type_raw": {
   "from": [
    "lineItem/LineItemType"
   ],
   "t": [
    "strip"
   ]
  },
  "coverage": {
   "from": [
    "lineItem/LineItemType"
   ],
   "t": [
    "strip",
    "coverage"
   ]
  },
  "instance_type": {
   "from": [
    "product/instanceType"
   ]
  },
  "operating_system": {
   "from": [
    "product/operatingSystem"
   ]
  },
  "database_engine": {
   "from": [
    "product/databaseEngine"
   ]
  },
  "deployment_option": {
   "from": [
    "product/deploymentOption"
   ]
  },
  "commitment_id": {
   "from": [
    "reservation/ReservationARN",
    "savingsPlan/SavingsPlanARN"
   ],
   "coalesce": true
  },
  "sku_id": {
   "from": [
    "product/sku"
   ]
  },
  "sku_price_id": {
   "from": [
    "pricing/RateCode"
   ]
  },
  "operation": {
   "from": [
    "lineItem/Operation"
   ]
  },
  "tenancy": {
   "from": [
    "product/tenancy"
   ]
  },
  "license_model": {
   "from": [
    "product/licenseModel"
   ]
  },
  "list_unit_price": {
   "from": [
    "pricing/publicOnDemandRate"
   ]
  },
  "pricing_term": {
   "from": [
    "pricing/term"
   ]
  },
  "purchase_option": {
   "from": [
    "pricing/PurchaseOption"
   ]
  },
  "resource_id": {
   "from": [
    "lineItem/ResourceId"
   ]
  }
 },
 "derive": {
  "effective_cost": "cur_effective(line_type_raw, billed_cost, col(\"reservation/EffectiveCost\"), col(\"savingsPlan/SavingsPlanEffectiveCost\"), col(\"reservation/UnusedAmortizedUpfrontFeeForBillingPeriod\"), col(\"reservation/UnusedRecurringFee\"), col(\"savingsPlan/TotalCommitmentToDate\"), col(\"savingsPlan/UsedCommitment\"))"
 }
}
