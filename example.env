# billparse settings.
# Copy to .env (in the project root) and fill in the keys:  cp example.env .env
# Variables set in your shell take priority over this file. ENV_FILE=/path/to/other.env loads a different file.

# --- LLM ------------------------------------------------------------------------
# Without a key, only the built-in specs, learned specs and the rule mapper run (no cost).
ANTHROPIC_API_KEY=
BILLPARSE_MODEL=claude-sonnet-5-5
# Effort of the spec route: low | medium | high | xhigh | max. Empty = the model's default (Sonnet 5.5: high,
# Haiku 5.5 and Opus 5.5: medium). Lower = fewer tokens, cheaper; the code checks every spec, so a weaker answer
# only fails more often, it never passes a wrong result.
BILLPARSE_EFFORT=
# Output tokens allowed per call (the model's thinking counts in them; too few gives "No JSON object in LLM response").
BILLPARSE_MAX_TOKENS=16000
# Seconds to wait for one call.
BILLPARSE_LLM_TIMEOUT=300
# Specs the LLM writes at once in the first round for a new layout (in parallel; the checks pick the best). 1 = one at
# a time, as before. Each candidate is one call: 2 costs one more call per new layout, and often saves a repair round.
BILLPARSE_SPEC_CANDIDATES=2
# The choices on the upload page, "model:effort", comma separated. Backend = the spec route of that upload, Fallback =
# its agent ("default" keeps the settings above; Fallback "none" turns the agent off for that upload).
LLM_CHOICES=haiku-5-5:low,haiku-5-5:medium,sonnet-5-5:medium,sonnet-5-5:high,opus-5-5:medium,opus-5-5:high
# Prices, USD per 1M tokens (input / output): claude-haiku-5-5 0.10 / 0.50, claude-sonnet-5-5 2 / 10,
# claude-opus-5-5 4 / 20. The cost of each parse shows as claude_cost_usd in its run; agent jobs show their own.
# 0 = never call the LLM from the API, even with a key (the upload page can still ask per file when it is 1).
BILLPARSE_USE_LLM=1

# --- Agent (a step of the parse: writes a spec for a layout no spec proves; costs money) ---
# 1 = a parse that a check contradicts, or that nothing could test, goes on with the agent step (once per layout).
# A file that prints no total to test (most CSV exports) is not sent: no spec can prove it. It needs ANTHROPIC_API_KEY.
# Without both, nothing is sent anywhere.
AGENT_ENABLED=0
BILLPARSE_AGENT_MODEL=claude-opus-5-5
# Effort of the agent: low | medium | high | xhigh | max (Opus 5.5's own default is medium).
AGENT_EFFORT=high
# Limits of one job: rounds (submit -> code checks -> feedback), tool calls per round, estimated cost, wall time,
# output tokens per model call. A limit ends the job with the best spec so far (never saved unless proved).
AGENT_MAX_ROUNDS=3
AGENT_TOOL_CALLS=40
AGENT_MAX_COST_USD=3.0
AGENT_MAX_SECONDS=900
AGENT_MAX_TOKENS=16000

# --- Storage --------------------------------------------------------------------
# The database. Empty: a SQLite file in PARSER_DATA_DIR. docker-compose.yml sets the PostgreSQL URL itself.
# DATABASE_URL=postgresql+psycopg://billparse:billparse@localhost:5434/billparse
# Uploads, result rows (Parquet), nightly reports, the row model. Relative paths are taken from the project root.
PARSER_DATA_DIR=store
# The AWS price files (scripts/aws/fetch_aws_price_files.py) that `make prices` loads into the price catalog.
# PRICE_FILES_DIR=~/aws-price-files
# The Azure retail prices (scripts/azure/fetch_azure_retail_prices.py) that `make prices-azure` loads.
# AZURE_PRICE_FILES_DIR=~/azure-price-files
# The GCP prices (scripts/gcp/fetch_gcp_prices.py) that `make prices ARGS="--provider gcp"` loads.
# GCP_PRICE_FILES_DIR=~/gcp-price-files
# The Cloud Billing Catalog API key for the GCP prices (a Google Cloud project with the Cloud Billing API enabled).
# Empty: the GCP fetcher stops with a message and the weekly refresh skips GCP.
GCP_BILLING_API_KEY=
# The service catalog (raw/ inputs, catalog.msgpack) and the synonyms that review teaches.
CATALOG_DIR=data
# PostgreSQL user, password and database for docker-compose.yml.
# POSTGRES_USER=billparse
# POSTGRES_PASSWORD=billparse
# POSTGRES_DB=billparse

# --- Ports (docker compose) -------------------------------------------------------
# API_PORT=8010
# WEB_PORT=8090

# --- API ------------------------------------------------------------------------
# Largest upload the API accepts, in MB.
MAX_UPLOAD_MB=2048
# POST /parse waits this many seconds for its parse; longer, it answers 202 with the job to poll (GET /parse/jobs/{id}).
PARSE_WAIT_SECONDS=300

# --- Jobs and workers (jobs.py, worker.py) ----------------------------------------------
# Every parse, reprice, learning run, price refresh and nightly loop is a row of the `job` table that a worker runs.
# Threads of the `worker` container for small files (the `small` queue); learning has 1 thread of its own.
PARSE_WORKERS=2
# 1 = this process runs the jobs itself (one thread per queue). Default: 1 with SQLite (make api-local, the tests),
# 0 with PostgreSQL (docker compose: the worker containers run them).
# INLINE_WORKER=
# Seconds a worker waits between two looks at an empty queue (PostgreSQL also wakes it at once: LISTEN/NOTIFY).
WORKER_POLL_SECONDS=1
# The longest a job may run, per queue, in seconds; then it ends `error`.
JOB_DEADLINE_SMALL=1800
JOB_DEADLINE_LEARN=3600
JOB_DEADLINE_LARGE=7200
JOB_DEADLINE_MAINTENANCE=7200
# Memory of the worker-large container (large files, the price refresh: a full load peaks near 2 GB).
LARGE_WORKER_MEM=6g

# --- Schedules (run by the workers; an empty value turns one off) ---------------------
# The weekly price refresh: download every AWS price list and the Savings Plans into PRICE_FILES_DIR, then load
# them. Day: mon tue wed thu fri sat sun. Hour in UTC.
PRICES_REFRESH_DAY=sun
PRICES_REFRESH_HOUR_UTC=10
# The providers the weekly refresh downloads and loads, in this order, comma separated: aws, azure, gcp (Azure: the
# public Azure Retail Prices API into AZURE_PRICE_FILES_DIR; GCP needs GCP_BILLING_API_KEY). Lines of a provider
# whose prices are not loaded stay no_catalog.
PRICE_PROVIDERS=aws
# Azure only: the services to fetch, comma separated (empty: the fetcher's ~20 most billed services; "all": every
# service), and the regions (armRegionName, comma separated; empty: every region).
# AZURE_PRICE_SERVICES=
# AZURE_PRICE_REGIONS=
# Price matching: a line that prints no region or OS is priced with the file's own most common value, else these
# (an empty value: none); each is noted on its lines and in the document's pricing.defaults_used. 0: assume only what
# a request gives.
PRICE_AUTO_DEFAULTS=1
# PRICE_DEFAULT_REGION_AWS=us-east-1
# PRICE_DEFAULT_REGION_AZURE=eastus
# PRICE_DEFAULT_OS=Linux
# The nightly loop, every day at this hour (UTC). With AGENT_ENABLED=1 it queues learning runs: they cost money.
NIGHTLY_HOUR_UTC=11

# --- Webhooks (POST /parse/jobs?callback_url=...) --------------------------------------
# URL prefixes a callback may start with, comma separated; empty = webhooks off (a callback_url gets 400). https only,
# except http://localhost and http://127.0.0.1.
CALLBACK_ALLOWLIST=
# The key of the X-Billparse-Signature header: sha256=<hex HMAC-SHA256 of the body>.
CALLBACK_SECRET=

# --- Large files (bigfile.py) -------------------------------------------------------
# A CSV or Parquet file larger than this, uncompressed, is read in chunks with bounded memory (smaller: in memory,
# which needs about 10 times the file size). In a pod with more memory, set it to about LARGE_MEMORY_MB / 10.
LARGE_FILE_MB=100
# Larger than this uncompressed: refused, with a message to split the export.
MAX_UNCOMPRESSED_GB=50
# The first rows the routes (built-in, learned, mapper, LLM) read to choose the spec for the whole file; fewer when
# the file is wide, so that the sample has at most SAMPLE_CELLS values (rows x columns).
SAMPLE_ROWS=50000
SAMPLE_CELLS=2500000
# Rows read at a time; fewer when the spec reads many columns (at most CHUNK_CELLS values: the columns the spec reads
# plus about 50 the steps add, x rows), and fewer again after the first chunk when it needs more than half of
# LARGE_MEMORY_MB. Only the columns the spec names are read.
CHUNK_ROWS=250000
CHUNK_CELLS=12000000
# The memory one large parse aims to stay within, above the process baseline.
LARGE_MEMORY_MB=2048
# Large parses at the same time (threads of the worker-large container); the others wait as "queued".
LARGE_PARSE_WORKERS=1
# Threads that read and parse one large CSV.
LARGE_IO_THREADS=2
# More distinct line texts than this: instance type, engine and the other details are not read from the texts.
MAX_UNIQUE_TEXTS=500000
# processes that read PDF pages in parallel (default: the CPUs, at most 8; 1 reads in the parse thread)
# PDF_WORKERS=8

# --- Sign-in for the web app -------------------------------------------------------
# off: no sign-in (local development). google: a verified Google account of ALLOWED_EMAIL_DOMAIN, plus an invite
# code the first time. The API checks every request (the web app, /api and port 8000).
AUTH=off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=               # long random text, e.g. `openssl rand -base64 48`; keep it stable
ALLOWED_EMAIL_DOMAIN=archera.ai
INVITE_CODES=                 # label=code pairs, comma separated, e.g. team=<random>,demo=<random>
PUBLIC_URL=                   # optional: the address people open, e.g. https://billparse.example.com
SESSION_HTTPS_ONLY=0          # 1: the session cookie is sent over https only

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
